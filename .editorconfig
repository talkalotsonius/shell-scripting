# EditorConfig is awesome: https://editorconfig.org
# This file provides consistent coding styles between different editors and IDEs
# Supports IntelliJ and VS Code, and perhaps many more editors

# Top-most EditorConfig file
root = true

# =============================================================================
# General rules for all files and EditorConfig settings
# =============================================================================
[*]
# Character set
charset = utf-8
# End of line style (Unix-style line endings)
end_of_line = lf
# Ensure file ends with a newline
insert_final_newline = true
# Trim trailing whitespace
trim_trailing_whitespace = true

# Indentation style
indent_style = space
indent_size = 4
tab_width = 2
# Maximum line length
max_line_length = 150

# IntelliJ specific general settings
ij_continuation_indent_size = 4
ij_formatter_off_tag = @formatter:off
ij_formatter_on_tag = @formatter:on
ij_formatter_tags_enabled = false
ij_smart_tabs = false
ij_wrap_on_typing = false

# Ignore EditorConfig and Linting settings for:
# generated, submodule or helm chart code
[{**build/**,**spec/**,**scripts/**,**/helm/templates/**,*gradle**,package-lock.json}]
generated_code = true
ij_formatter_enabled = false
ktlint = disabled
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
max_line_length = unset

[.editorconfig]
ij_editorconfig_align_group_field_declarations = false
ij_editorconfig_space_after_colon = false
ij_editorconfig_space_after_comma = true
ij_editorconfig_space_before_colon = false
ij_editorconfig_space_before_comma = false
ij_editorconfig_spaces_around_assignment_operators = true

# =============================================================================
# YAML files
# =============================================================================
[*.{yaml,yml}]
# Indentation for YAML
indent_size = 2

# IntelliJ-specific settings for YAML
ij_continuation_indent_size = 2
ij_yaml_indent_sequence_value = true
ij_yaml_keep_indents_on_empty_lines = false
ij_yaml_keep_line_breaks = true

# =============================================================================
# JSON files
# =============================================================================
[{*.json,.jsonlintrc}]
# Indentation for JSON
indent_size = 2
ij_continuation_indent_size = 2

# IntelliJ-specific settings for JSON
ij_json_keep_blank_lines_in_code = 0
ij_json_keep_indents_on_empty_lines = false
ij_json_keep_line_breaks = true
ij_json_space_after_colon = true
ij_json_space_after_comma = true
ij_json_space_before_colon = false
ij_json_space_before_comma = false
ij_json_spaces_within_braces = false
ij_json_spaces_within_brackets = false
ij_json_wrap_long_lines = false
# IntelliJ JSON-specific array formatting
ij_json_array_wrapping = split_into_lines
ij_json_object_wrapping = split_into_lines
ij_json_property_alignment = do_not_align

# =============================================================================
# XML files
# =============================================================================
[*.{xml,xsd}]
ij_continuation_indent_size = 2
ij_xml_block_comment_at_first_column = true
ij_xml_keep_indents_on_empty_lines = false
ij_xml_line_comment_at_first_column = true


# =============================================================================
# Documentation files Markdown, AsciiDoc
# =============================================================================
[*.{md,mdx}]
# Don't trim trailing whitespace in Markdown (two spaces = line break)
trim_trailing_whitespace = false
# Indentation
indent_size = 2

# IntelliJ specific settings for Markdown
ij_continuation_indent_size = 2
ij_markdown_force_one_space_after_blockquote_symbol = true
ij_markdown_force_one_space_after_header_symbol = true
ij_markdown_force_one_space_after_list_bullet = true
ij_markdown_force_one_space_between_words = true
ij_markdown_keep_indents_on_empty_lines = false
ij_markdown_max_lines_around_block_elements = 1
ij_markdown_max_lines_around_header = 1
ij_markdown_max_lines_between_paragraphs = 1
ij_markdown_min_lines_around_block_elements = 1
ij_markdown_min_lines_around_header = 1
ij_markdown_min_lines_between_paragraphs = 1

[*.{adoc,asciidoc,asc}]
# Don't trim trailing whitespace in AsciiDoc (two spaces = line break)
trim_trailing_whitespace = false
# Indentation
indent_size = 2

# IntelliJ specific settings for AsciiDoc
ij_continuation_indent_size = 2

# =============================================================================
# Shell script files
# =============================================================================
[{*.{zsh,bash,sh},.githooks/commit-msg,.githooks/pre-commit,.githooks/pre-commit-hooks/*-lint}]
# Indentation
indent_size = 2

# IntelliJ-specific settings for Shell scripts
ij_shell_binary_ops_start_line = false
ij_shell_keep_column_alignment_padding = false
ij_shell_minify_program = false
ij_shell_redirect_followed_by_space = false
ij_shell_switch_cases_indented = false
